# ---------------------------------------------------------------------
# Copy to .env.local for local development, and set the same values in
# the Vercel project's Environment Variables for production.
#
# Every value below is a fake placeholder. Replace all of them.
#
# None of these are NEXT_PUBLIC_*, so none of them are readable by the
# browser or bundled into client JavaScript. They are used only by the
# scheduled refresh, which runs on the server.
# ---------------------------------------------------------------------


# --- Snapshot store (required in production) --------------------------
#
# Upstash Redis. Holds one gzipped JSON blob: the last-known-good reading
# from every platform. This is what lets a section keep showing figures
# when Codeforces or CodeChef is down.
#
# Create a free database at console.upstash.com, then copy the two REST
# values from its dashboard. Vercel KV is Upstash underneath and sets the
# identical variable names, so connecting it from the Vercel Marketplace
# populates these automatically.
#
# WITHOUT THESE the app still runs, but falls back to per-instance memory
# that the cron and the page renderer do not share — so carry-forward
# silently does nothing. Check the "driver" field returned by
# /api/revalidate after deploying: it must say "upstash".
#
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as
# aliases if you prefer Upstash's own naming.

KV_REST_API_URL="https://example-otter-12345.upstash.io"
KV_REST_API_TOKEN="AaBbCcDdEeFf0123456789exampleTokenValueNotReal9876543210"


# --- Refresh authentication (strongly recommended) --------------------
#
# Shared secret gating /api/revalidate. That route performs writes and
# spends API rate-limit budget, so it should not be freely triggerable.
#
# Set the SAME value in three places:
#   1. here / Vercel env vars
#   2. the GitHub repository secret CRON_SECRET
#   3. nothing else — Vercel Cron sends it automatically
#
# Generate one with:  openssl rand -hex 32
#
# If left unset the route stays open. That is not catastrophic — it only
# reads public data — but anyone could burn your GitHub rate limit.

CRON_SECRET="0000111122223333444455556666777788889999aaaabbbbccccddddeeeeffff"


# --- GitHub API token (optional) --------------------------------------
#
# Raises the GitHub REST limit from 60 requests/hour to 5,000, which lets
# the per-repository language byte counts refresh every 30 minutes rather
# than every 6 hours. Everything works without it.
#
# A fine-grained token with NO scopes at all is enough — every endpoint
# used here is public. Do not grant repo write access.

GITHUB_TOKEN="github_pat_11EXAMPLE0000000000_FakePlaceholderTokenDoNotUse"


# ---------------------------------------------------------------------
# Also required, but they live in GitHub, not here:
#
#   Repository secret SITE_URL      https://your-domain.vercel.app
#   Repository secret CRON_SECRET   the same value as above
#
# .github/workflows/refresh-stats.yml uses them to call the refresh every
# 30 minutes. Vercel's Hobby plan rejects sub-daily crons at deploy time,
# which is why the schedule lives in GitHub Actions instead.
# ---------------------------------------------------------------------
